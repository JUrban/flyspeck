needs "arith/cv_compute_partition_iargs.hl";;

open Cv_compute_partition_iargs;;

let cv_partition_profile_process_cpu_ticks () =
  let input = TextIO.openIn "/proc/self/stat" in
  let text = TextIO.inputAll input in
  let _ = TextIO.closeIn input in
  let fields = Cake.String.tokens (fun c -> c = ' ') text in
  int_of_string (List.nth fields 13) + int_of_string (List.nth fields 14);;

let cv_partition_profile_start = cv_partition_profile_process_cpu_ticks ();;

let cv_partition_profile_tree_count =
  itlist
    (fun (_,tree) count ->
       let encoded = cv_partition_iargs_term tree in
       if cv_partition_iargs_shape tree <> cv_partition_term_shape encoded then
         failwith "Iarg/encoded partition shape mismatch";
       count + 1)
    !Break_case_log.break_data 0;;

let cv_partition_profile_ticks =
  cv_partition_profile_process_cpu_ticks () - cv_partition_profile_start;;

let cv_partition_profile_shape =
  itlist
    (fun (_,tree) (leaves,facets,bisects,nodes,max_depth) ->
       let l,f,b,n,d = cv_partition_iargs_shape tree in
       leaves + l,facets + f,bisects + b,nodes + n,max max_depth d)
    !Break_case_log.break_data
    (0,0,0,0,0);;

let cv_partition_profile_leaves,cv_partition_profile_facets,
    cv_partition_profile_bisects,cv_partition_profile_nodes,
    cv_partition_profile_max_depth = cv_partition_profile_shape;;

let cv_partition_profile_tree_shapes =
  map
    (fun (identifier,tree) ->
       let leaves,facets,_,nodes,depth = cv_partition_iargs_shape tree in
       identifier,leaves + facets,nodes,depth)
    !Break_case_log.break_data;;

let cv_partition_profile_by_cases =
  sort
    (fun (_,left,_,_) (_,right,_,_) -> left < right)
    cv_partition_profile_tree_shapes;;

let cv_partition_profile_min_id,cv_partition_profile_min_cases,
    cv_partition_profile_min_nodes,cv_partition_profile_min_tree_depth =
  List.hd cv_partition_profile_by_cases;;
let cv_partition_profile_median_id,cv_partition_profile_median_cases,
    cv_partition_profile_median_nodes,cv_partition_profile_median_depth =
  List.nth cv_partition_profile_by_cases 231;;
let cv_partition_profile_max_id,cv_partition_profile_max_cases,
    cv_partition_profile_max_nodes,cv_partition_profile_max_tree_depth =
  List.nth cv_partition_profile_by_cases 462;;

let cv_partition_profile_count_at_least threshold =
  List.length
    (filter
      (fun (_,cases,_,_) -> threshold <= cases)
      cv_partition_profile_tree_shapes);;

let cv_partition_profile_cases_at_least threshold =
  itlist
    (fun (_,cases,_,_) total ->
       if threshold <= cases then total + cases else total)
    cv_partition_profile_tree_shapes 0;;

if List.length !Break_case_log.break_data <> 463 ||
   cv_partition_profile_tree_count <> 463 ||
   cv_partition_profile_leaves <> 7479 ||
   cv_partition_profile_facets <> 15462 ||
   cv_partition_profile_bisects <> 7016 ||
   cv_partition_profile_nodes <> 29957 ||
   cv_partition_profile_leaves + cv_partition_profile_facets <> 22941 ||
   cv_partition_profile_max_depth <> 40
then failwith "authenticated Flyspeck partition inventory mismatch";;

print_endline
  ("CANDLE_CV_PARTITION_IARGS_TICKS=" ^
   string_of_int cv_partition_profile_ticks);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_TREES=" ^
   string_of_int cv_partition_profile_tree_count);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_CASES=" ^
   string_of_int
     (cv_partition_profile_leaves + cv_partition_profile_facets));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_NODES=" ^
   string_of_int cv_partition_profile_nodes);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_MIN_CASES=" ^
   string_of_int cv_partition_profile_min_cases);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_MEDIAN_CASES=" ^
   string_of_int cv_partition_profile_median_cases);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_MAX_CASES=" ^
   string_of_int cv_partition_profile_max_cases);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_MAX_CASE_NODES=" ^
   string_of_int cv_partition_profile_max_nodes);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_GE_64_CASES=" ^
   string_of_int (cv_partition_profile_count_at_least 64));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_GE_128_CASES=" ^
   string_of_int (cv_partition_profile_count_at_least 128));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_GE_256_CASES=" ^
   string_of_int (cv_partition_profile_count_at_least 256));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_GE_512_CASES=" ^
   string_of_int (cv_partition_profile_count_at_least 512));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_GE_1024_CASES=" ^
   string_of_int (cv_partition_profile_count_at_least 1024));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_CASES_GE_64=" ^
   string_of_int (cv_partition_profile_cases_at_least 64));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_CASES_GE_128=" ^
   string_of_int (cv_partition_profile_cases_at_least 128));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_CASES_GE_256=" ^
   string_of_int (cv_partition_profile_cases_at_least 256));;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_MIN_ID=" ^ cv_partition_profile_min_id);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_MEDIAN_ID=" ^ cv_partition_profile_median_id);;
print_endline
  ("CANDLE_CV_PARTITION_IARGS_MAX_ID=" ^ cv_partition_profile_max_id);;
print_endline "CANDLE_CV_PARTITION_IARGS_OK";;
