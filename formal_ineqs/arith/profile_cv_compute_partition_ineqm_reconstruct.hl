(* ======================================================================== *)
(* Real-corpus comparison of the existing Iarg proof assembly and the       *)
(* proof-producing partition adapter.                                      *)
(*                                                                          *)
(* DEVELOPMENT / NON-RELEASE.  Load this only after Break_case_exec and     *)
(* Serialization.  Authenticate each leaf exactly once, then compare the    *)
(* two proof-assembly paths over that shared theorem vector.  In particular *)
(* do not clear Serialization.hash2: it is the dependency-history cache,    *)
(* not a per-leaf result cache, and rebuilding it is outside this profile.   *)
(* ======================================================================== *)

needs "arith/cv_compute_partition_ineqm_reconstruct.hl";;

open Cv_compute_partition_iargs;;
open Cv_compute_partition_ineqm_reconstruct;;
open Break_case_exec;;

let cv_partition_reconstruct_profile_tokens text =
  let finish current fields =
    if current = "" then List.rev fields
    else List.rev (current :: fields) in
  let rec scan index current fields =
    if index = String.length text then finish current fields
    else
      let character = String.get text index in
      if character = ' ' || character = '\n' then
        if current = "" then scan (index + 1) "" fields
        else scan (index + 1) "" (current :: fields)
      else
        scan (index + 1)
          (current ^ String.make 1 character) fields in
  scan 0 "" [];;

let cv_partition_reconstruct_profile_process_cpu_ticks () =
  let input = TextIO.openIn "/proc/self/stat" in
  let text = TextIO.inputAll input in
  let _ = TextIO.closeIn input in
  let fields = cv_partition_reconstruct_profile_tokens text in
  int_of_string (List.nth fields 13) + int_of_string (List.nth fields 14);;

let cv_partition_reconstruct_profile_clock_smoke =
  cv_partition_reconstruct_profile_process_cpu_ticks ();;
let _ =
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_CLOCK_TICKS=" ^
     string_of_int cv_partition_reconstruct_profile_clock_smoke);;

let cv_partition_reconstruct_profile_cases tree =
  let leaves,facets,_,_,_ = cv_partition_iargs_shape tree in
  leaves + facets;;

let cv_partition_reconstruct_profile_nodes tree =
  let _,_,_,nodes,_ = cv_partition_iargs_shape tree in
  nodes;;

let cv_partition_reconstruct_profile_ordered =
  sort
    (fun (_,left) (_,right) ->
       cv_partition_reconstruct_profile_nodes left <
       cv_partition_reconstruct_profile_nodes right)
    !Break_case_log.break_data;;

if List.length cv_partition_reconstruct_profile_ordered <> 463
then failwith "nonlinear partition corpus cardinality mismatch";;

let cv_partition_reconstruct_profile_samples =
  ["small",List.hd cv_partition_reconstruct_profile_ordered;
   "median",List.nth cv_partition_reconstruct_profile_ordered 231;
   "heavy",List.nth cv_partition_reconstruct_profile_ordered 462];;

let cv_partition_reconstruct_profile_baseline_from_leaves
      target tree leaf_theorems =
  let propositions = mk_case_list target tree in
  let _ =
    List.length propositions = List.length leaf_theorems ||
      failwith "preauthenticated leaf cardinality mismatch" in
  let _ =
    forall2
      (fun proposition theorem -> aconv proposition (concl theorem))
      propositions leaf_theorems ||
      failwith "preauthenticated leaf conclusion mismatch" in
  let assumptions = prove_iargs_cases target tree in
  let discharged = itlist PROVE_HYP leaf_theorems assumptions in
    REWRITE_RULE
      [LENGTH;LENGTH_bisect_left;LENGTH_bisect_right;
       LENGTH_frac_left;LENGTH_frac_right]
      (DISCH_ALL discharged);;

let cv_partition_reconstruct_profile_one label (identifier,tree) =
  let mark phase =
    print_endline
      ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^ "_STEP=" ^ phase) in
  let _ = mark "BEGIN" in
  let target = get_ineq identifier in
  let expected_cases = cv_partition_reconstruct_profile_cases tree in
  let expected_nodes = cv_partition_reconstruct_profile_nodes tree in
  let _ = mark "AUTHENTICATION_BEGIN" in
  let authentication_start =
    cv_partition_reconstruct_profile_process_cpu_ticks () in
  let leaf_theorems =
    map Serialization.mk_ser_thm (mk_case_list target tree) in
  let authentication_ticks =
    cv_partition_reconstruct_profile_process_cpu_ticks () -
    authentication_start in
  let _ = mark "AUTHENTICATION_END" in
  let _ = mark "BASELINE_GLUE_BEGIN" in
  let baseline_glue_start =
    cv_partition_reconstruct_profile_process_cpu_ticks () in
  let baseline_glue =
    cv_partition_reconstruct_profile_baseline_from_leaves
      target tree leaf_theorems in
  let baseline_glue_ticks =
    cv_partition_reconstruct_profile_process_cpu_ticks () -
    baseline_glue_start in
  let _ = mark "BASELINE_GLUE_END" in
  let _ = mark "PARTITION_INDEX_BEGIN" in
  let index_start = cv_partition_reconstruct_profile_process_cpu_ticks () in
  let leaf_index : (term,thm) Hashtbl.t =
    Hashtbl.create expected_cases in
  let _ =
    map
      (fun theorem -> Hashtbl.add leaf_index (concl theorem) theorem)
      leaf_theorems in
  let index_ticks =
    cv_partition_reconstruct_profile_process_cpu_ticks () - index_start in
  let _ = mark "PARTITION_INDEX_END" in
  let partition_glue_leaf_count = ref 0 in
  let partition_glue_leaf proposition =
    let _ =
      partition_glue_leaf_count := !partition_glue_leaf_count + 1 in
      try Hashtbl.find leaf_index proposition
      with Not_found -> failwith "preauthenticated partition leaf missing" in
  let partition_glue_start =
    cv_partition_reconstruct_profile_process_cpu_ticks () in
  let _ = mark "PARTITION_GLUE_BEGIN" in
  let partition_glue =
    cv_partition_ineqm_reconstruct_cases
      partition_glue_leaf target tree in
  let partition_glue_ticks =
    cv_partition_reconstruct_profile_process_cpu_ticks () -
    partition_glue_start in
  let _ = mark "PARTITION_GLUE_END" in
  if !partition_glue_leaf_count <> expected_cases ||
     hyp baseline_glue <> [] || hyp partition_glue <> [] ||
     not (aconv (concl baseline_glue) (concl partition_glue))
  then failwith ("partition reconstruction mismatch: " ^ identifier);
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^ "_ID=" ^ identifier);
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^ "_CASES=" ^
     string_of_int expected_cases);
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^ "_NODES=" ^
     string_of_int expected_nodes);
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^
     "_AUTHENTICATION_TICKS=" ^ string_of_int authentication_ticks);
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^
     "_BASELINE_GLUE_TICKS=" ^ string_of_int baseline_glue_ticks);
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^
     "_PARTITION_INDEX_TICKS=" ^ string_of_int index_ticks);
  print_endline
    ("CANDLE_CV_PARTITION_RECONSTRUCT_" ^ label ^
     "_PARTITION_GLUE_TICKS=" ^ string_of_int partition_glue_ticks);
  (authentication_ticks,baseline_glue_ticks,index_ticks,
   partition_glue_ticks);;

let cv_partition_reconstruct_profile_backup =
  !Serialization.use_serialization;;
let _ = Serialization.use_serialization := true;;
let _ = Serialization.deserialization_axiom ();;
let cv_partition_reconstruct_profile_axioms = axioms ();;
let cv_partition_reconstruct_profile_results =
  try
    let results =
      map
        (fun (label,sample) ->
           cv_partition_reconstruct_profile_one label sample)
        cv_partition_reconstruct_profile_samples in
    let _ =
      Serialization.use_serialization :=
        cv_partition_reconstruct_profile_backup in
    results
  with error ->
    let _ =
      Serialization.use_serialization :=
        cv_partition_reconstruct_profile_backup in
    raise error;;

if not (set_eq (axioms ()) cv_partition_reconstruct_profile_axioms)
then failwith "partition profile changed the global axiom set";;

print_endline "CANDLE_CV_PARTITION_RECONSTRUCT_OK";;
