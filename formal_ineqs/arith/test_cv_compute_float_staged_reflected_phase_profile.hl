(* DEVELOPMENT / NON-RELEASE comparison of the legacy staged proof path and
   the coarse validity-compute plus one-shot-soundness path. *)

needs "arith/cv_compute_float_staged_reflected.hl";;
needs "arith/test_cv_compute_float_taylor.hl";;
needs "arith/cv_compute_float_taylor_batch.hl";;

open Cv_compute_float_staged_polynomial;;
open Cv_compute_float_staged_reflected;;
open Cv_compute_float_taylor;;

let cv_reflected_phase_process_cpu_seconds () =
  let input = TextIO.openIn "/proc/self/stat" in
  let text = TextIO.inputAll input in
  let _ = TextIO.closeIn input in
  let fields = Cake.String.tokens (fun c -> c = ' ') text in
  float_of_int
    (int_of_string (List.nth fields 13) +
     int_of_string (List.nth fields 14)) /. 100.0;;

let cv_reflected_phase_first_iabs =
  map cv_taylor_float_iabs cv_float_taylor_test_dfs;;

let cv_reflected_phase_first_monomials =
  map2
    (fun w eq -> [w;rand (concl eq)])
    cv_float_taylor_test_ws cv_reflected_phase_first_iabs;;

let cv_reflected_phase_second_iabs,
    cv_reflected_phase_second_lhs,
    cv_reflected_phase_second_monomials =
  Cv_compute_float_taylor_batch.cv_taylor_second_reflection
    cv_float_taylor_test_ws cv_float_taylor_test_dds;;

let cv_reflected_phase_legacy_started =
  cv_reflected_phase_process_cpu_seconds ();;
let cv_reflected_phase_legacy_first =
  cv_float_staged_product_sum_hi 8
    cv_reflected_phase_first_monomials;;
let cv_reflected_phase_legacy_second =
  cv_float_staged_product_sum_hi 8
    cv_reflected_phase_second_monomials;;
let cv_reflected_phase_legacy_seconds =
  cv_reflected_phase_process_cpu_seconds () -.
  cv_reflected_phase_legacy_started;;

let cv_reflected_phase_profiles :
    cv_staged_polynomial_profile list ref = ref [];;
let _ =
  cv_staged_polynomial_profile_clock :=
    cv_reflected_phase_process_cpu_seconds;
  cv_staged_polynomial_profile_sink :=
    Some
      (fun profile ->
        cv_reflected_phase_profiles :=
          profile :: !cv_reflected_phase_profiles);;

let cv_reflected_phase_started =
  cv_reflected_phase_process_cpu_seconds ();;
let cv_reflected_phase_first,cv_reflected_phase_second =
  try
    let first =
      cv_float_staged_product_sum_hi_reflected 8
        cv_reflected_phase_first_monomials in
    let second =
      cv_float_staged_product_sum_hi_reflected 8
        cv_reflected_phase_second_monomials in
    cv_staged_polynomial_profile_sink := None;
    cv_staged_polynomial_profile_clock := Unix.gettimeofday;
    first,second
  with failure ->
    (cv_staged_polynomial_profile_sink := None;
     cv_staged_polynomial_profile_clock := Unix.gettimeofday;
     raise failure);;
let cv_reflected_phase_total_seconds =
  cv_reflected_phase_process_cpu_seconds () -.
  cv_reflected_phase_started;;
let cv_reflected_phase_profiles = rev !cv_reflected_phase_profiles;;

if length cv_reflected_phase_profiles <> 2 then
  failwith "reflected phase profile expected two evaluations";;
if hyp cv_reflected_phase_first <> [] ||
   hyp cv_reflected_phase_second <> [] then
  failwith "reflected phase profile theorem has assumptions";;
if not (aconv (concl cv_reflected_phase_first)
          (concl cv_reflected_phase_legacy_first)) ||
   not (aconv (concl cv_reflected_phase_second)
          (concl cv_reflected_phase_legacy_second)) then
  failwith "reflected phase profile theorem mismatch";;

let cv_reflected_phase_print role profile =
  print_endline
    ("CANDLE_CV_STAGED_REFLECTED_PHASE role=" ^ role ^
     " monomials=" ^ string_of_int profile.input_monomials ^
     " factors=" ^ string_of_int profile.input_factors ^
     " source_plan_seconds=" ^ string_of_float profile.source_plan_seconds ^
     " precompute_proof_seconds=" ^
       string_of_float profile.precompute_proof_seconds ^
     " kernel_compute_seconds=" ^
       string_of_float profile.kernel_compute_seconds ^
     " theorem_handoff_seconds=" ^
       string_of_float profile.theorem_handoff_seconds);;

let cv_reflected_phase_first_profile =
  List.nth cv_reflected_phase_profiles 0 and
    cv_reflected_phase_second_profile =
      List.nth cv_reflected_phase_profiles 1;;
cv_reflected_phase_print
  "first_derivative" cv_reflected_phase_first_profile;;
cv_reflected_phase_print
  "second_derivative" cv_reflected_phase_second_profile;;

let cv_reflected_phase_accounted_seconds =
  itlist
    (fun profile total ->
      profile.source_plan_seconds +. profile.precompute_proof_seconds +.
      profile.kernel_compute_seconds +. profile.theorem_handoff_seconds +.
      total)
    cv_reflected_phase_profiles 0.0;;

print_endline
  ("CANDLE_CV_STAGED_REFLECTED_LEGACY_SECONDS=" ^
   string_of_float cv_reflected_phase_legacy_seconds);;
print_endline
  ("CANDLE_CV_STAGED_REFLECTED_TOTAL_SECONDS=" ^
   string_of_float cv_reflected_phase_total_seconds);;
print_endline
  ("CANDLE_CV_STAGED_REFLECTED_ACCOUNTED_SECONDS=" ^
   string_of_float cv_reflected_phase_accounted_seconds);;
print_endline "CANDLE_CV_STAGED_REFLECTED_PHASE_PROFILE_OK";;
