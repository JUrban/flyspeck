let candle_flyspeck_dir =
  try Sys.getenv "FLYSPECK_DIR" with Not_found -> Sys.getcwd();;

let candle_hollight_dir =
  try Sys.getenv "HOLLIGHT_DIR" with Not_found -> failwith "HOLLIGHT_DIR";;

let candle_pft_output =
  try Sys.getenv "CANDLE_PFT_OUTPUT"
  with Not_found -> failwith "CANDLE_PFT_OUTPUT";;

needs (Filename.concat candle_hollight_dir "ProofTrace/pft.ml");;
pft_stream_checkpoint_interval := 250000;;
start_pft_stream candle_pft_output;;

let new_axiom _ =
  failwith "new_axiom has been disabled for Flyspeck leaf export";;

needs (Filename.concat candle_flyspeck_dir "general/hol-library.hl");;
save_pft_stream_target "flyspeck$IMAGE_DELETE_INJ_COMPAT"
  IMAGE_DELETE_INJ_COMPAT;;
save_pft_stream_target "flyspeck$HAS_SIZE_2_EXISTS" HAS_SIZE_2_EXISTS;;

let candle_hol_library_export_stats = pft_stream_stats();;
let candle_hol_library_export_result = finish_pft_stream();;
print_endline "FLYSPECK_HOL_LIBRARY_EXPORT_OK";;
